<?xml version="1.0"?>
<package format="3">
  <name>duo_joint</name>
  <version>0.1.0</version>
  <description>
    Dual Motor Synchronized Joint - POC (ROS 2 Humble)
    URDF and control configuration for synchronized dual Dynamixel motors.
  </description>
  <author email="napat559977@gmail.com">SKUBA Team</author>
  <maintainer email="napat559977@gmail.com">SKUBA Team</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Build System -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core Dependencies -->
  <depend>robot_state_publisher</depend>
  <depend>controller_manager</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <!-- Export -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
